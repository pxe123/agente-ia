# Copie para .env na raiz do projeto (agente-ia / ZapAction).

# --- Obrigatório ---
SECRET_KEY=
SUPABASE_URL=
# Service role (secret) — Settings → API → service_role
SUPABASE_KEY=
# Anon/public — obrigatória para login Auth e /nova-senha (Settings → API → anon)
SUPABASE_ANON_KEY=
# Aliases aceitos pelo app: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWT_SECRET=

# --- Billing (Stripe) ---
# Assinaturas recorrentes via Stripe (Checkout + Webhook + Portal)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Preços/planos: tabela plans no Supabase (migration 029_plans_stripe_ids.sql).
# stripe_price_id é preenchido pelo admin ou na 1ª checkout; migração legada:
# python scripts/sync_plan_stripe_prices_from_env.py (one-shot, se ainda tiver STRIPE_PRICE_* antigos)
# URLs de retorno (produção updigitalbrasil)
STRIPE_SUCCESS_URL=https://api.updigitalbrasil.com.br/painel?stripe=success
STRIPE_CANCEL_URL=https://api.updigitalbrasil.com.br/precos?stripe=cancel
STRIPE_PORTAL_RETURN_URL=https://api.updigitalbrasil.com.br/painel
# Webhook no Stripe Console (endpoint):
# https://api.updigitalbrasil.com.br/api/billing/stripe/webhook

# --- Agendamento IA (integração HTTP com agenda.zapaction.com.br) ---
# Em produção (padrão): USE_INTERNAL_SCHEDULING=0; motor por tenant em scheduling_settings.scheduling_engine (admin)
AGENDAMENTO_IA_BASE_URL=https://agenda.zapaction.com.br
AGENDAMENTO_IA_API_KEY=
# Igual a AGENT_BEARER_TOKEN no serviço Agendamento IA
ZAPACTION_WEBHOOK_SECRET=
# Igual a ZAPACTION_WEBHOOK_SECRET no Agendamento IA (webhook reverso)
USE_INTERNAL_SCHEDULING=0
# LEGADO / rede de segurança (Fase 1–2 pós-deploy BD): fallback se leitura BD falhar. Preferir admin PATCH.
# SCHEDULING_INTERNAL_CLIENTE_IDS=
# Break-glass: força Agenda mesmo com motor interno na BD
# SCHEDULING_FORCE_AGENDA_CLIENTE_IDS=
# Lembretes WhatsApp antes da consulta (cron: python scripts/run_scheduling_reminders.py)
# SCHEDULING_REMINDERS_ENABLED=0
# SCHEDULING_REMINDER_HOURS_BEFORE=24,1

# --- Google Calendar (OAuth no painel ZapAction — login direto, sem abrir o Agenda) ---
# Mesmo OAuth Client do Google Cloud usado no Agendamento IA; redirect URI adicional no Console:
# https://SEU_DOMINIO/painel/agenda/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api.updigitalbrasil.com.br/painel/agenda/google/callback

# Opcionais (derivam de BASE se vazios):
# AGENDAMENTO_IA_PUBLIC_BASE_URL=
# AGENDAMENTO_IA_WEBHOOK_URL=https://agenda.zapaction.com.br/v1/agendamento
# AGENDAMENTO_IA_CLINIC_SYNC_URL=https://agenda.zapaction.com.br/v1/integrations/zapaction/tenant-snapshot
# AGENDAMENTO_IA_LINK_GENERATE_URL=https://agenda.zapaction.com.br/v1/link/generate

# --- Agendamento IA (serviço FastAPI separado — referência) ---
# DATABASE_URL=
# AGENT_BEARER_TOKEN=
# SESSION_SECRET=
# ZAPACTION_APPOINTMENT_WEBHOOK_URL=https://SEU_DOMINIO/webhook/agendamento-ia/appointments
# LINK_TOKEN_SECRET=

# --- Cadastro público (anti-bot) ---
# Cloudflare Turnstile: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Emergência: bloqueia GET/POST /cadastro
# PUBLIC_SIGNUP_DISABLED=1
# USE_ONBOARDING_FUNNEL=1
